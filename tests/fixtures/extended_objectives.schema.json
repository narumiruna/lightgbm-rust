{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "upstream_commit",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "upstream_commit": {
      "const": "5d84f3f222b41409a6983d2ac90513ad9702fa9e"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "initial_scores": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            }
          },
          "gradients": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "hessians": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "scores": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "gradients": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                },
                "hessians": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "scores",
                "gradients",
                "hessians"
              ],
              "additionalProperties": false
            }
          },
          "renewals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "integer",
                  "minimum": 0
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "newton_output": {
                  "type": "number"
                },
                "expected_output": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": [
                        "Infinity",
                        "-Infinity",
                        "NaN"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "class",
                "rows",
                "newton_output",
                "expected_output"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "objective",
          "params",
          "labels",
          "scores",
          "initial_scores",
          "gradients",
          "hessians"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
