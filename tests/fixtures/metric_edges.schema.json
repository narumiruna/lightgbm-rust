        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "metric_value": {
          "type": "number"
        },
        "maximize": {
          "type": "boolean"
        },
        "metric_std_dev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dataset_name",
        "metric_name",
        "metric_value",
        "maximize",
        "metric_std_dev"
      ],
      "additionalProperties": false
    },
    "model": {
