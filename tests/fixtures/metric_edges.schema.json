          "type": "string",
          "pattern": "^models/[a-z0-9_]+\\.txt$"
        },
        "current_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "num_trees": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "transformed": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "leaves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0
          },
          "minItems": 1
