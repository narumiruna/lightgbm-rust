{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "metric_value": {
          "type": "number"
        },
        "maximize": {
          "type": "boolean"
        },
        "metric_std_dev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dataset_name",
        "metric_name",
        "metric_value",
        "maximize",
        "metric_std_dev"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "model_file": {
          "type": "string",
          "pattern": "^models/[a-z0-9_]+\\.txt$"
        },
        "current_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "num_trees": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "transformed": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "leaves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0
          },
          "minItems": 1
        }
      },
      "required": [
        "model_file",
        "current_iteration",
        "num_trees",
        "raw",
        "transformed",
        "leaves"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "current_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "num_trees": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "transformed": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "leaves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0
          },
          "minItems": 1
        }
      },
      "required": [
        "current_iteration",
        "num_trees",
        "raw",
        "transformed",
        "leaves"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "upstream_commit": {
          "const": "5d84f3f222b41409a6983d2ac90513ad9702fa9e"
        },
        "loaded_library_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "python_sources": {
          "type": "object",
          "properties": {
            "engine.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "callback.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "basic.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "compat.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "engine.py",
            "callback.py",
            "basic.py",
            "compat.py"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "numpy": {
              "type": "string",
              "minLength": 1
            },
            "scipy": {
              "type": "string",
              "minLength": 1
            },
            "scikit-learn": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "numpy",
            "scipy",
            "scikit-learn"
          ],
          "additionalProperties": false
        },
        "execution": {
          "type": "string",
          "minLength": 1
        },
        "iteration_index": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "upstream_commit",
        "loaded_library_sha256",
        "python_sources",
        "dependencies",
        "execution",
        "iteration_index"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 0
        }
      }
    },
    "folds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "train_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "valid_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          }
        },
        "required": [
          "train_indices",
          "valid_indices"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "params": {
      "type": "object",
      "minProperties": 1
    },
    "dump_tree": {
      "type": "object",
      "properties": {
        "split_gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        },
        "left_child": {
          "$ref": "#/$defs/dump_tree"
        },
        "right_child": {
          "$ref": "#/$defs/dump_tree"
        }
      }
    },
    "original_training": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "groups": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "positions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "num_boost_round": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rows",
        "labels",
        "num_boost_round"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "upstream_commit": {
      "const": "5d84f3f222b41409a6983d2ac90513ad9702fa9e"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "$ref": "#/$defs/params"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 0
            },
            "minItems": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          },
          "valid_sets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "is_training": {
                  "type": "boolean"
                },
                "labels": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "name",
                "is_training",
                "labels"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "num_boost_round": {
            "type": "integer",
            "minimum": 1
          },
          "stopping": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "stopping_rounds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "first_metric_only": {
                    "type": "boolean"
                  },
                  "verbose": {
                    "type": "boolean"
                  },
                  "min_delta": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 0
                      }
                    ]
                  }
                },
                "required": [
                  "stopping_rounds",
                  "first_metric_only",
                  "verbose",
                  "min_delta"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "learning_rate_schedule": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "callback_order": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "order": {
                  "type": "integer"
                },
                "before_iteration": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "order",
                "before_iteration"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "callback": {
                  "type": "string",
                  "minLength": 1
                },
                "phase": {
                  "enum": [
                    "enter",
                    "exit",
                    "raise"
                  ]
                },
                "iteration": {
                  "type": "integer",
                  "minimum": 0
                },
                "begin_iteration": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_iteration": {
                  "type": "integer",
                  "minimum": 1
                },
                "model_current_iteration": {
                  "type": "integer",
                  "minimum": 0
                },
                "model_best_iteration": {
                  "type": "integer",
                  "minimum": 0
                },
                "learning_rate": {
                  "type": "number"
                },
                "evaluation": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/metric"
                      },
                      "minItems": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "history_lengths": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "enabled": {
                  "type": "boolean"
                },
                "best_iterations_zero": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 0
                },
                "exception_best_iteration_zero": {
                  "type": "integer",
                  "minimum": 0
                },
                "exception_best_score": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/metric"
                  },
                  "minItems": 0
                },
                "error_type": {
                  "type": "string",
                  "minLength": 1
                },
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "callback",
                "phase",
                "iteration",
                "begin_iteration",
                "end_iteration",
                "model_current_iteration",
                "model_best_iteration",
                "learning_rate",
                "evaluation",
                "history_lengths"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "history": {
            "$ref": "#/$defs/history"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "derivatives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "raw_input": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                },
                "gradients": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                },
                "hessians": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "raw_input",
                "gradients",
                "hessians"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "best_iteration": {
            "type": "integer",
            "minimum": 0
          },
          "best_score": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "live_model": {
            "$ref": "#/$defs/snapshot"
          },
          "final_model": {
            "$ref": "#/$defs/model"
          },
          "full_model": {
            "$ref": "#/$defs/model"
          },
          "builtin_reference": {
            "$ref": "#/$defs/model"
          },
          "builtin_evaluation": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/metric"
            },
            "minItems": 0
          },
          "error_layer": {
            "type": "string",
            "minLength": 1
          },
          "error_type": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "params",
          "rows",
          "labels",
          "valid_sets",
          "num_boost_round",
          "stopping",
          "learning_rate_schedule",
          "callback_order",
          "events",
          "history",
          "warnings",
          "derivatives"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "error_type",
              "error",
              "error_layer"
            ]
          },
          {
            "required": [
              "best_iteration",
              "best_score",
              "live_model",
              "final_model",
              "full_model"
            ]
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "upstream_commit",
    "provenance",
    "cases"
  ],
  "additionalProperties": false
}
