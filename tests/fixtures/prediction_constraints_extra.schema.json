{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "upstream_commit": {
      "const": "5d84f3f222b41409a6983d2ac90513ad9702fa9e"
    },
    "library": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "loaded_path",
        "loaded_sha256",
        "verification"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "loaded_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "compiler": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "version",
        "selected_toolchain_path",
        "selected_toolchain_sha256"
      ]
    },
    "compile_commands_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "cat_extra_onehot",
              "cat_extra_sorted",
              "cat_quantized",
              "cat_quantized_renew",
              "cat_smooth",
              "deep_monotone_advanced",
              "deep_monotone_basic",
              "deep_monotone_intermediate",
              "deep_monotone_smooth",
              "interaction_sampled"
            ]
          },
          "params": {
            "type": "object",
            "minProperties": 1
          },
          "model_file": {
            "type": "string",
            "pattern": "^models/constraints_extra/[a-z_]+\\.txt$"
          },
          "training": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              },
              "weights": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              },
              "num_boost_round": {
                "const": 4
              }
            },
            "required": [
              "rows",
              "labels",
              "weights",
              "num_boost_round"
            ],
            "additionalProperties": false
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          },
          "raw": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          },
          "leaves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "name",
          "params",
          "model_file",
          "training",
          "rows",
          "raw",
          "leaves"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "upstream_commit",
    "library",
    "compiler",
    "compile_commands_sha256",
    "producer_sha256",
    "cases"
  ],
  "additionalProperties": false
}
