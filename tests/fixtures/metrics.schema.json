{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "upstream_commit",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "upstream_commit": {
      "const": "5d84f3f222b41409a6983d2ac90513ad9702fa9e"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "params": {
            "type": "object"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "metric": {
            "type": "string"
          },
          "source_class_need_train": {"type": "array", "items": {"type": "boolean"}},
          "model_objective": {"type": "string"},
          "results": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": [
                        "Infinity",
                        "-Infinity",
                        "NaN"
                      ]
                    }
                  ]
                },
                "higher_is_better": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "value",
                "higher_is_better"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "metric",
          "objective",
          "params",
          "labels",
          "scores",
          "results"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
