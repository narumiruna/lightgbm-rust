{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "metric": {
      "type": "object",
      "properties": {
        "dataset_name": {
          "type": "string",
          "minLength": 1
        },
        "metric_name": {
          "type": "string",
          "minLength": 1
        },
        "metric_value": {
          "type": "number"
        },
        "maximize": {
          "type": "boolean"
        },
        "metric_std_dev": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dataset_name",
        "metric_name",
        "metric_value",
        "maximize",
        "metric_std_dev"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "model_file": {
          "type": "string",
          "pattern": "^models/[a-z0-9_]+\\.txt$"
        },
        "current_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "num_trees": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "transformed": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "leaves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0
          },
          "minItems": 1
        }
      },
      "required": [
        "model_file",
        "current_iteration",
        "num_trees",
        "raw",
        "transformed",
        "leaves"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "current_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "num_trees": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "transformed": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "leaves": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 0
          },
          "minItems": 1
        }
      },
      "required": [
        "current_iteration",
        "num_trees",
        "raw",
        "transformed",
        "leaves"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "upstream_commit": {
          "const": "5d84f3f222b41409a6983d2ac90513ad9702fa9e"
        },
        "loaded_library_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "python_sources": {
          "type": "object",
          "properties": {
            "engine.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "callback.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "basic.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "compat.py": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "engine.py",
            "callback.py",
            "basic.py",
            "compat.py"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "object",
          "properties": {
            "numpy": {
              "type": "string",
              "minLength": 1
            },
            "scipy": {
              "type": "string",
              "minLength": 1
            },
            "scikit-learn": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "numpy",
            "scipy",
            "scikit-learn"
          ],
          "additionalProperties": false
        },
        "execution": {
          "type": "string",
          "minLength": 1
        },
        "iteration_index": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "upstream_commit",
        "loaded_library_sha256",
        "python_sources",
        "dependencies",
        "execution",
        "iteration_index"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 0
        }
      }
    },
    "folds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "train_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "valid_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          }
        },
        "required": [
          "train_indices",
          "valid_indices"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "params": {
      "type": "object",
      "minProperties": 1
    },
    "dump_tree": {
      "type": "object",
      "properties": {
        "split_gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          ]
        },
        "left_child": {
          "$ref": "#/$defs/dump_tree"
        },
        "right_child": {
          "$ref": "#/$defs/dump_tree"
        }
      }
    },
    "original_training": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 0
          },
          "minItems": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        "groups": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "positions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "num_boost_round": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rows",
        "labels",
        "num_boost_round"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "upstream_commit": {
      "const": "5d84f3f222b41409a6983d2ac90513ad9702fa9e"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "params": {
            "$ref": "#/$defs/params"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 0
            },
            "minItems": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1
          },
          "groups": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "num_boost_round": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          },
          "nfold": {
            "type": "integer",
            "minimum": 2
          },
          "stratified": {
            "type": "boolean"
          },
          "shuffle": {
            "type": "boolean"
          },
          "fold_generator": {
            "type": "string",
            "minLength": 1
          },
          "permutation": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "source_folds": {
            "$ref": "#/$defs/folds"
          },
          "folds": {
            "$ref": "#/$defs/folds"
          },
          "aggregate_std": {
            "const": "population; original engine numpy.std ddof=0"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "iteration": {
                  "type": "integer",
                  "minimum": 0
                },
                "aggregate": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/metric"
                  },
                  "minItems": 0
                },
                "folds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "evaluation": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/metric"
                        },
                        "minItems": 0
                      },
                      "current_iteration": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "evaluation",
                      "current_iteration"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 2
                }
              },
              "required": [
                "iteration",
                "aggregate",
                "folds"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "history": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            }
          },
          "stopping": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "stopping_rounds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "min_delta": {
                    "type": "number"
                  }
                },
                "required": [
                  "stopping_rounds",
                  "min_delta"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "best_iteration": {
            "type": "integer",
            "minimum": -1
          },
          "cvbooster_file": {
            "type": "string",
            "pattern": "^models/cv_[a-z_]+_booster\\.json$"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "best_iteration": {
                  "type": "integer",
                  "minimum": -1
                },
                "final_model": {
                  "$ref": "#/$defs/model"
                },
                "full_model": {
                  "$ref": "#/$defs/model"
                }
              },
              "required": [
                "best_iteration",
                "final_model",
                "full_model"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          }
        },
        "required": [
          "name",
          "params",
          "rows",
          "labels",
          "groups",
          "num_boost_round",
          "seed",
          "nfold",
          "stratified",
          "shuffle",
          "fold_generator",
          "permutation",
          "source_folds",
          "folds",
          "aggregate_std",
          "steps",
          "history",
          "stopping",
          "best_iteration",
          "cvbooster_file",
          "models"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "upstream_commit",
    "provenance",
    "cases"
  ],
  "additionalProperties": false
}
